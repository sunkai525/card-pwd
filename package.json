    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "workerd@1.20261116.1": true,
    "esbuild@0.28.2": true
  }
